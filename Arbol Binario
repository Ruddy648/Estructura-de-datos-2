class Nodo:

    def __init__(self,dato):
        self.dato=dato
        self.izquierda=None
        self.derecha= None


class Arbol:

    def __init__(self):
        self.raiz= None


    def insertar(self,dato):
        self.raiz= self._insertar_recursivo(self.raiz,dato)


    def _insertar_recursivo(self,nodo,dato):
        if not nodo:
            return Nodo(dato)

        if dato<nodo.dato:
            nodo.izquierda= self._insertar_recursivo(nodo.izquierda,dato)

        else:
            if dato>nodo.dato:
                nodo.derecha=self._insertar_recursivo(nodo.derecha,dato)
            else:
                print("El valor ya se encuentra en el arbol")
                return nodo

        return nodo

    def inorder(self):
        self._inorder_recursivo(self.raiz)

    def _inorder_recursivo(self,nodo):
        if not nodo.izquierda:
            print(f"{self._inorder_recursivo(nodo.izquierda)}")
